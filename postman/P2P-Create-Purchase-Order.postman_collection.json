              "raw": "{\n  \"decision\": \"approved\",\n  \"reason\": \"One-time approval — filing proof to follow this week.\"\n}"
            },
            "url": "{{base_url}}/p2p/orders/gst-approvals/{{approval_id}}/decide",
            "description": "decision: approved | rejected. Reason is required either way."
          }
        },
        {
          "name": "Inbox — history (approver)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{approver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/p2p/orders/gst-approvals?history=1"
          }
        }
      ],
      "description": "Only when the supplier's GST return is overdue (gate approval_required). A stale scrutiny (blocked) cannot be approved past."
    },
    {
      "name": "4. Documents (Stage 04)",
      "item": [
        {
          "name": "List documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.length) pm.collectionVariables.set('doc_id', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents"
          }
        },
        {
          "name": "Generate Purchase Order PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Re-renders the PO PDF onto the Purchase Order document (pending only). Also runs automatically on submit.",
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/{{doc_id}}/generate"
          }
        },
        {
          "name": "Add document (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Quality Agreement",
                  "type": "text"
                },
                {
                  "key": "doc_kind",
                  "value": "agreement",
                  "type": "text"
                },
                {
                  "key": "is_required",
                  "value": "no",
                  "type": "text"
                },
                {
                  "key": "valid_up_to",
                  "value": "2027-09-30",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents"
          }
        },
        {
          "name": "Attach / replace file (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/{{doc_id}}/file"
          }
        },
        {
          "name": "Mark sent / signed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"sent\"\n}"
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/{{doc_id}}/status"
          }
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/{{doc_id}}/download"
          }
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/{{doc_id}}"
          }
        },
        {
          "name": "Send for e-signature (Zoho Sign)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Signer defaults to the supplier primary contact; override with signer_name / signer_email. Returns signature_request_id for the tracker.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_ids\": [{{doc_id}}],\n  \"notes\": \"Please review and sign.\",\n  \"expiry_days\": 30\n}"
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/sign"
          }
        },
        {
          "name": "Email documents to supplier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Sends the files to the supplier primary contact email; override with \"to\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_ids\": [{{doc_id}}]\n}"
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/documents/email"
          }
        },
        {
          "name": "Signing tracker (shared CLM endpoint)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clm/signature-requests/{{sig_id}}",
            "description": "Use signature_request_id from the document list. Also re-reads the status from Zoho."
          }
        }
      ]
    },
    {
      "name": "5. Physical inspection",
      "item": [
        {
          "name": "Inspection status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/p2p/orders/{{po_id}}/inspection"
          }
        },
        {
          "name": "Mark a line (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "verdict",
                  "value": "correct",
                  "type": "text"
                },
                {
                  "key": "remark",
                  "value": "Seal intact, quantity matches.",
                  "type": "text"
                },
                {
                  "key": "files[]",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/inspection/lines/{{item_id}}"
          }
        },
        {
          "name": "Sign off (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "note",
                  "value": "All lines inspected on receipt.",
                  "type": "text"
                },
                {
                  "key": "files[]",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{base_url}}/p2p/orders/{{po_id}}/inspection/sign-off"
          }
        },
        {
          "name": "Withdraw sign-off",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/p2p/orders/{{po_id}}/inspection/withdraw"
          }
        }
      ]
    }
  ]
}