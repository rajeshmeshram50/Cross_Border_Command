<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ── gzip / DEFLATE compression ───────────────────────────────────────
# Compresses JSON API responses and other text payloads on the wire
# before they hit the browser. A 140 KB master bundle drops to ~25 KB
# typical, ~10 KB on highly repetitive JSON. mod_deflate is included
# with Apache by default on XAMPP; if `apachectl -M | grep deflate`
# shows nothing on production, enable it with `a2enmod deflate`.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml

    # Some old proxies/AVs strip Content-Length on compressed responses
    # and Apache then refuses to send. Force Vary so downstream caches
    # don't serve the compressed body to non-supporting clients.
    Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# ── Static asset caching ─────────────────────────────────────────────
# Vite emits CONTENT-HASHED filenames under /build/assets (e.g.
# app-a1b2c3d4.js); the URL changes whenever the bytes change, so a new
# deploy ships new hashes and stale files are never served. That makes
# them safe to cache for a year, immutable. Without this the browser
# re-downloads the whole asset set on every visit — Lighthouse flagged
# ~12 MB of avoidable re-downloads ("Use efficient cache lifetimes").
#
# The rule is scoped to /build/assets/ via mod_rewrite (sets an env var)
# so non-hashed files served elsewhere from public/ are unaffected.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^build/assets/ - [E=HASHED_ASSET:1]
</IfModule>
<IfModule mod_headers.c>
    # Hashed build assets → cache 1 year, immutable.
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

    # Non-hashed static assets (logos, email icons, favicons) live outside
    # /build, so they can't be cached forever — give them a moderate TTL
    # with revalidation instead.
    <FilesMatch "\.(?:png|jpe?g|gif|svg|webp|avif|ico|woff2?)$">
        Header setifempty Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
