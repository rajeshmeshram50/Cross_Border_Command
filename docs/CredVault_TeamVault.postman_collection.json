                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/credvault/normal-vault/credentials?tab=team&member_employee_id={{teamMemberEmployeeId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "credvault",
                                "normal-vault",
                                "credentials"
                            ],
                            "query": [
                                {
                                    "key": "tab",
                                    "value": "team"
                                },
                                {
                                    "key": "member_employee_id",
                                    "value": "{{teamMemberEmployeeId}}"
                                }
                            ]
                        },
                        "description": "A member with no login yet answers 422 (\"has no CredVault login yet\")."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                                ]
                            }
