                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/credvault/normal-vault/credentials?tab=team&department_id={{teamDeptId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "credvault",
                                "normal-vault",
                                "credentials"
                            ],
                            "query": [
                                {
                                    "key": "tab",
                                    "value": "team"
                                },
                                {
                                    "key": "department_id",
                                    "value": "{{teamDeptId}}"
                                }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "pm.test('tab counts', () => pm.expect(b.tabs).to.include.keys('mine', 'team'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Table — Team Credentials, search",
                    "request": {
