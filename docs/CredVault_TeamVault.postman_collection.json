                            ],
                            "path": [
                                "credvault",
                                "normal-vault",
                                "credentials"
                            ],
                            "query": [
                                {
                                    "key": "tab",
                                    "value": "team"
                                },
                                {
                                    "key": "department_id",
                                    "value": "{{teamDeptId}}"
                                },
                                {
                                    "key": "q",
                                    "value": "github"
                                }
                            ]
